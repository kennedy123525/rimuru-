# Put these in Replit Secrets (padlock icon), NOT in a file.
# This file only lists the names.

# --- AI providers (any one is enough; more = better fallback) ---
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp login (the number Rimuru will run on, digits only, with country code) ---
PAIRING_NUMBER=

# --- Owner (comma-separate if you have several ids, e.g. phone,lid) ---
OWNER_NAME=Kennedy
OWNER_NUMBER=
OWNER_SHOW_NUMBER=false

# --- Kennedy protection (digits only; comma-separate phone and LID) ---
PROTECTED_CONTACT_ID=
PROTECTED_ENABLED=true
PROTECTED_COOLDOWN_MS=5000

# --- Tuning (optional) ---
PREFIX=.
MEMORY_LIMIT=20
AI_TIMEOUT_MS=20000
AI_USER_COOLDOWN_MS=1500
STICKER_PACK=Rimuru
STICKER_AUTHOR=Made by Rimuru
MUSIC_COUNTRY=US

# --- .dl downloader (optional) ---
# TikTok and direct file links work with nothing set. For YouTube, Instagram, Twitter/X, Facebook etc.
# point this at a cobalt server (your own, or one you have a key for), e.g. https://cobalt.example.com
COBALT_API_URL=
COBALT_API_KEY=
DL_MAX_MB=60

# --- Database (needed on hosts with no permanent disk, e.g. Render free) ---
# Paste your Neon connection string here (in Render's Environment tab).
DATABASE_URL=

# --- Claiming the owner role: send ".claim <passphrase>" to Rimuru in a PRIVATE chat ---
# Pick something long and secret. If empty, .claim is switched off.
CLAIM_PASSPHRASE=
# --- Personality: savage (cocky, blunt, unbothered) or calm (the original) ---
PERSONALITY=savage
